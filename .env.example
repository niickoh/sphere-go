# Mismas variables que el .env de Django (DB_ENGINE ya no se usa)
PORT=8080
SECRET_KEY=            # usar EL MISMO valor que Django para que las sesiones activas sigan válidas

DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASS=
DB_SSLMODE=prefer      # disable | prefer | require

IAM_VERIFY_LOGIN=True
IAM_ME_URL=https://bff-auth.sportspherecenter.com/auth/me
IAM_LOCAL_BYPASS=False # True solo en desarrollo local

SWAGGER_ENABLED=False  # True en dev para tener /swagger/ y /redoc/; False en producción

MAILJET_API_KEY=
MAILJET_API_SECRET=
MAIL_FROM_EMAIL=
CONTACT_EMAIL_TO=
CONTACT_UPAC_EMAIL_TO=

# Opcionales (por defecto usan los valores que estaban en settings.py)
# WEBPUSH_VAPID_PUBLIC_KEY=
# WEBPUSH_VAPID_PRIVATE_KEY=
# WEBPUSH_VAPID_SUBJECT=mailto:admin@tu-dominio.com
